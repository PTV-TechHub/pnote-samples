  <block type="procedures_defnoreturn" x="1880" y="40">
    <mutation>
      <arg name="speed" varid="v_speed" />
      <arg name="distanceMm" varid="v_distanceMm" />
    </mutation>
    <field name="NAME">Forward</field>
    <statement name="STACK">
      <block type="lb_motion_run">
        <field name="UnitSpeed">sps</field>
        <value name="Left">
          <block type="variables_get">
            <field name="VAR" id="v_speed">speed</field>
          </block>
        </value>
        <value name="Right">
          <block type="variables_get">
            <field name="VAR" id="v_speed">speed</field>
          </block>
        </value>
        <next>
          <block type="lb_motion_wait_distance">
            <field name="UnitDistance">mm</field>
            <value name="distanceMm">
              <block type="variables_get">
                <field name="VAR" id="v_distanceMm">distanceMm</field>
              </block>
            </value>
            <next>
              <block type="lb_motion_stop" />
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="procedures_defnoreturn" x="1880" y="220">
    <mutation>
      <arg name="speed" varid="v_speed" />
      <arg name="distanceMm" varid="v_distanceMm" />
    </mutation>
    <field name="NAME">Backward</field>
    <statement name="STACK">
      <block type="lb_motion_run">
        <field name="UnitSpeed">sps</field>
        <value name="Left">
          <block type="math_arithmetic">
            <field name="OP">MINUS</field>
            <value name="A">
              <block type="math_number">
                <field name="NUM">0</field>
              </block>
            </value>
            <value name="B">
              <block type="variables_get">
                <field name="VAR" id="v_speed">speed</field>
              </block>
            </value>
          </block>
        </value>
        <value name="Right">
          <block type="math_arithmetic">
            <field name="OP">MINUS</field>
            <value name="A">
              <block type="math_number">
                <field name="NUM">0</field>
              </block>
            </value>
            <value name="B">
              <block type="variables_get">
                <field name="VAR" id="v_speed">speed</field>
              </block>
            </value>
          </block>
        </value>
        <next>
          <block type="lb_motion_wait_distance">
            <field name="UnitDistance">mm</field>
            <value name="distanceMm">
              <block type="variables_get">
                <field name="VAR" id="v_distanceMm">distanceMm</field>
