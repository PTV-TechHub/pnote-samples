  <block type="procedures_defnoreturn" x="500" y="960">
    <field name="NAME">notHandleE4</field>
    <statement name="STACK">
      <block type="text_print">
        <value name="TEXT">
          <block type="text">
            <field name="TEXT">ColorDemo: expected RED, YELLOW, GREEN or BLUE; no block moved.</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="procedures_defnoreturn" x="1180" y="40">
