<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="v_speed">speed</variable>
    <variable id="v_color">color</variable>
    <variable id="v_distanceMm">distanceMm</variable>
    <variable id="v_deg">deg</variable>
    <variable id="v_targetMm">targetMm</variable>
    <variable id="v_lineValue">lineValue</variable>
    <variable id="v_junctionCount">junctionCount</variable>
  </variables>
  <block type="leanbot_when_started" x="40" y="40">
    <comment pinned="false" h="250" w="400">Leanbot detects a random color at E4, then collects or neutralizes it.
Start
- Leanbot at CRL
- Pollution: ? at E4 (one pollution site selects RED/YELLOW/GREEN/BLUE)
- Neutralizer: Blue at S3, Green at S4
Leanbot steps
- Go to E4 and read the color without touching the block
- Red/Yellow: pick up pollution, reverse into CRL without turning, drop it
- Blue/Green: fetch the matching neutralizer from S3/S4
- Return to E4, push pollution into containment E, drop the neutralizer
- Mission end

Leanbot.begin() is generated by the IDE. Final score is omitted because there is no existing Blockly block.</comment>
    <next>
      <block type="variables_set">
        <field name="VAR" id="v_speed">speed</field>
        <value name="VALUE">
          <block type="math_number">
            <field name="NUM">2000</field>
          </block>
        </value>
        <next>
          <block type="procedures_callnoreturn">
            <mutation name="setupSynapseCity" />
            <next>
              <block type="lb_mission_begin_digital_twin">
                <value name="missionId">
                  <block type="text">
                    <field name="TEXT">SynapseCity.01</field>
                  </block>
                </value>
                <statement name="BODY">
                  <block type="leanbot_section">
                    <field name="commentString">Go to E4</field>
                    <statement name="BODY">
                      <block type="procedures_callnoreturn">
                        <mutation name="FromCRLtoE4" />
                      </block>
                    </statement>
                    <next>
                      <block type="leanbot_section">
                        <field name="commentString">Detect color</field>
                        <statement name="BODY">
                          <block type="variables_set">
                            <field name="VAR" id="v_color">color</field>
                            <value name="VALUE">
                              <block type="sc_detect_color" />
                            </value>
                            <next>
                              <block type="text_print">
                                <value name="TEXT">
                                  <block type="text_join">
                                    <mutation items="3" />
                                    <value name="ADD0">
                                      <block type="text">
                                        <field name="TEXT">Detected color:</field>
                                      </block>
                                    </value>
                                    <value name="ADD1">
                                      <block type="text">
                                        <field name="TEXT"> </field>
                                      </block>
                                    </value>
                                    <value name="ADD2">
                                      <block type="variables_get">
                                        <field name="VAR" id="v_color">color</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <next>
                          <block type="leanbot_section">
                            <field name="commentString">Handle color</field>
                            <statement name="BODY">
                              <block type="controls_if">
                                <mutation elseif="3" else="1" />
                                <value name="IF0">
                                  <block type="logic_compare">
                                    <field name="OP">EQ</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="v_color">color</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="text">
                                        <field name="TEXT">RED</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="procedures_callnoreturn">
                                    <mutation name="handleE4Red" />
                                  </block>
                                </statement>
                                <value name="IF1">
                                  <block type="logic_compare">
                                    <field name="OP">EQ</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="v_color">color</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="text">
                                        <field name="TEXT">YELLOW</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO1">
                                  <block type="procedures_callnoreturn">
                                    <mutation name="handleE4Yellow" />
                                  </block>
                                </statement>
                                <value name="IF2">
                                  <block type="logic_compare">
                                    <field name="OP">EQ</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="v_color">color</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="text">
                                        <field name="TEXT">GREEN</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO2">
                                  <block type="procedures_callnoreturn">
                                    <mutation name="handleE4Green" />
                                  </block>
                                </statement>
                                <value name="IF3">
                                  <block type="logic_compare">
                                    <field name="OP">EQ</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="v_color">color</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="text">
                                        <field name="TEXT">BLUE</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO3">
                                  <block type="procedures_callnoreturn">
                                    <mutation name="handleE4Blue" />
                                  </block>
                                </statement>
                                <statement name="ELSE">
                                  <block type="procedures_callnoreturn">
                                    <mutation name="notHandleE4" />
                                  </block>
                                </statement>
                              </block>
                            </statement>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
  <block type="procedures_defnoreturn" x="40" y="1000">
    <field name="NAME">setupSynapseCity</field>
    <statement name="STACK">
      <block type="sc_set_blocks">
        <field name="Layout">S3  Blue
S4  Green</field>
        <next>
          <block type="sc_set_blocks">
            <field name="Layout">E4  ?</field>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="procedures_defnoreturn" x="500" y="40">
    <field name="NAME">handleE4Red</field>
    <statement name="STACK">
      <block type="procedures_callnoreturn">
        <mutation name="PickupPollutionE4" />
        <next>
          <block type="procedures_callnoreturn">
            <mutation name="FromE4toCRL" />
            <next>
              <block type="procedures_callnoreturn">
                <mutation name="DropPollutionCRL" />
                <next>
                  <block type="text_print">
                    <value name="TEXT">
                      <block type="text_join">
                        <mutation items="3" />
                        <value name="ADD0">
                          <block type="text">
                            <field name="TEXT">Collected at CRL:</field>
                          </block>
                        </value>
                        <value name="ADD1">
                          <block type="text">
                            <field name="TEXT"> </field>
                          </block>
                        </value>
                        <value name="ADD2">
                          <block type="text">
                            <field name="TEXT">RED</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
