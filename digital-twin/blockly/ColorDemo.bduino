  </block>
  <block type="procedures_defnoreturn" x="1520" y="40">
    <field name="NAME">FromE4toS3</field>
    <statement name="STACK">
      <block type="procedures_callnoreturn">
        <mutation name="Backward">
          <arg name="speed" />
          <arg name="distanceMm" />
        </mutation>
        <value name="ARG0">
          <block type="variables_get">
            <field name="VAR" id="v_speed">speed</field>
          </block>
        </value>
        <value name="ARG1">
          <block type="math_number">
            <field name="NUM">50</field>
          </block>
        </value>
        <next>
          <block type="procedures_callnoreturn">
            <mutation name="Rotate">
              <arg name="speed" />
              <arg name="deg" />
            </mutation>
            <value name="ARG0">
              <block type="math_arithmetic">
                <field name="OP">MINUS</field>
                <value name="A">
                  <block type="math_number">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get">
                    <field name="VAR" id="v_speed">speed</field>
                  </block>
                </value>
              </block>
            </value>
            <value name="ARG1">
              <block type="math_number">
                <field name="NUM">105</field>
              </block>
            </value>
            <next>
              <block type="procedures_callnoreturn">
                <mutation name="followLineMultipleJunctions">
                  <arg name="junctionCount" />
                </mutation>
                <value name="ARG0">
                  <block type="math_number">
                    <field name="NUM">2</field>
                  </block>
                </value>
                <next>
                  <block type="procedures_callnoreturn">
                    <mutation name="goToJunction" />
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
